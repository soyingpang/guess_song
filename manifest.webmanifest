{
  "name": "估歌仔",
  "short_name": "估歌仔",
  "description": "手機自用估歌遊戲：反轉向下播歌，反轉向上顯示答案。",
  "lang": "zh-Hant",
  "dir": "ltr",
  "id": "./solo.html",
  "start_url": "./solo.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#050505",
  "theme_color": "#050505",
  "categories": ["games", "entertainment", "music"],
  "icons": [
    {
      "src": "./assets/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "估歌仔",
      "short_name": "開始",
      "url": "./solo.html?source=shortcut",
      "icons": [{ "src": "./assets/app-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
