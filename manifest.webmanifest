{
  "name": "估歌仔",
  "short_name": "估歌仔",
  "description": "團契與朋友聚會的現場估歌遊戲；主持電腦播歌，玩家手機答題。",
  "lang": "zh-Hant",
  "dir": "ltr",
  "id": "./index.html",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#050505",
  "theme_color": "#050505",
  "categories": ["games", "entertainment", "music"],
  "icons": [
    {
      "src": "./assets/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "主持開場",
      "short_name": "主持",
      "url": "./index.html?source=shortcut",
      "icons": [{ "src": "./assets/app-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
