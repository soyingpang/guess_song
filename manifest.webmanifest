{
  "name": "估歌仔 · 全球手機版",
  "short_name": "估歌仔",
  "description": "團契和朋友聚會用的手機估歌遊戲，支援全球房間、搶答、計分和聲音同步。",
  "lang": "zh-Hant",
  "dir": "ltr",
  "id": "./player.html",
  "start_url": "./player.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#fff4e6",
  "theme_color": "#fff4e6",
  "categories": ["games", "entertainment", "music"],
  "icons": [
    {
      "src": "./assets/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "加入手機房間",
      "short_name": "加入",
      "url": "./player.html?source=shortcut",
      "icons": [{ "src": "./assets/app-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "主持開場",
      "short_name": "主持",
      "url": "./index.html?source=shortcut",
      "icons": [{ "src": "./assets/app-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
